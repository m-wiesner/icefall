\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Normalized histograms of word-level IoU and recording-level mean IoU. The two corpora use identical bin edges within each panel. Higher is better.}}{1}{}\protected@file@percent }
\newlabel{fig:alignment-iou-histograms}{{1}{1}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Normalized histograms of word-level and recording-level boundary error. A word's boundary error is the mean absolute error of its onset and offset; each recording-level observation averages that value over one recording. The word-level panel uses logarithmically spaced bins, with exact zeros included in the $0.1$\,ms bin. Lower is better.}}{1}{}\protected@file@percent }
\newlabel{fig:alignment-boundary-histograms}{{2}{1}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Normalized histograms of word-level and recording-level ordering error. Since Kendall distance is a sequence statistic, each word receives half the number of inversions involving it; its mean within a recording is exactly the reported inversions-per-word metric. Lower is better.}}{2}{}\protected@file@percent }
\newlabel{fig:alignment-kendall-histograms}{{3}{2}}
\gdef \@abspage@last{2}
