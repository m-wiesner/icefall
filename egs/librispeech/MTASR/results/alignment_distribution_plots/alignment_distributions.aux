\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Word-level and recording-level distributions of intersection over union (IoU). Each recording-level observation is the unweighted mean of the word IoUs in one recording. Higher values are better.}}{1}{}\protected@file@percent }
\newlabel{fig:alignment-iou-distributions}{{1}{1}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Word-level and recording-level boundary-error distributions. A word's boundary error is the mean of its absolute onset and offset errors; each recording-level observation averages that quantity over the words in one recording. The word panel uses a logarithmic horizontal axis, with exact zeros displayed at $0.1$\,ms. Lower values are better.}}{1}{}\protected@file@percent }
\newlabel{fig:alignment-boundary-distributions}{{2}{1}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Word-level and recording-level ordering-error distributions. The Kendall distance is intrinsically a sequence statistic. For the word panel, each inversion is split equally between its two participating words; hence the mean word contribution within a recording is exactly the reported recording-level Kendall distance (raw inversions divided by words). The word panel uses a logarithmic horizontal axis, with exact zeros displayed at $0.01$. Lower values are better.}}{2}{}\protected@file@percent }
\newlabel{fig:alignment-kendall-distributions}{{3}{2}}
